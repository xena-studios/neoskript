{
  "name": "neoskript-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/parser.mjs && astro build && node scripts/headers.mjs && node scripts/skill.mjs",
    "preview": "astro preview",
    "brand:sync": "node scripts/sync-brand.mjs",
    "syntax:sync": "node scripts/syntax.mjs",
    "syntax:export": "cd .. && ./gradlew :test-harness:harness -Pharness.env=paper-26.3 -Pharness.scenario=syntax-export && cd website && node scripts/syntax.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "parser": "cd .. && ./gradlew :neoskript-web:website"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.10",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.8"
  },
  "devDependencies": {
    "starlight-links-validator": "^0.27.0",
    "wrangler": "^4.159.0"
  }
}
