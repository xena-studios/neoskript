---
// Starlight's footer (edit link, last updated, previous and next), then the
// site footer the custom pages have: the XENA endorsement and licence line.
import Default from "@astrojs/starlight/components/Footer.astro";
import SiteFooter from "../SiteFooter.astro";
---
<Default />
<div class="site-footer-wrap"><SiteFooter /></div>

<style>
  /* In a guide the footer sits in the content column, which has its own padding: no gutter of its own (the
     guides define --gutter for their header). */
  .site-footer-wrap {
    --gutter: 0;
    margin-top: 3rem;
  }
</style>
