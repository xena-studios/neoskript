---
// Replaces Starlight's social icons, which it shows in the guides' header and
// mobile menu, with the site's navigation, so the syntax reference, parser and
// downloads are one click away from every guide, as from the custom pages.
import External from "../External.astro";
import { current, nav, repo } from "../../lib/nav";

const path = Astro.url.pathname;
---
<ul class="site-nav">
  {nav.map((item) => <li><a href={item.href} aria-current={current(path, item.href) ? "page" : undefined}>{item.label}</a></li>)}
  <li><a href={repo}>GitHub<External /></a></li>
</ul>

<style>
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    margin: 0;
  }
  a {
    color: var(--sl-color-gray-3);
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
  }
  a:hover,
  a[aria-current="page"] {
    color: var(--sl-color-white);
  }
</style>
