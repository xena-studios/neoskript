---
// One of the tools' icons (src/lib/icons.ts), decorative: the control it's in carries the label.
// Styled by .icon in src/styles/site.css; a class passed in (or a parent's scoping class) is added to it.
import { icons, type IconName } from "../lib/icons";
interface Props { name: IconName; class?: string }
const { name, class: className } = Astro.props;
---
<svg class:list={["icon", className]} viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d={icons[name]} /></svg>
