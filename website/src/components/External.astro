---
// The outbound arrow from xenastudios.co (its only icon): authored SVG in
// currentColor, nudging up-right on hover and focus. Every link to another
// site carries it.
---
<svg class="external" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true" focusable="false">
  <path d="M2.5 7.5 7.5 2.5M3.5 2.5h4v4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
</svg>
<style>
  .external {
    width: 0.62em;
    height: 0.62em;
    margin-left: 0.3em;
    vertical-align: 0.05em;
    transition: transform 180ms var(--ease);
  }
  :global(a:hover) > .external,
  :global(a:focus-visible) > .external {
    transform: translate(1px, -1px);
  }
</style>
