---
// The in-browser parser: NeoSkript's frontend, compiled to JavaScript by TeaVM
// (neoskript-web/), runs in a Web Worker and checks the script in a Monaco
// editor. A full-window tool under the site header: a menu bar, the editor with
// the results beside it, and a status bar. The behaviour is in
// src/scripts/parser-page.ts; Monaco loads from src/scripts/parser-editor.ts.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import External from "../components/External.astro";
import { repo } from "../lib/nav";
// What the parser checks against, as the worker says once it's loaded: the committed syntax export's header.
import { neoskript, server } from "../data/syntax.json";

const examples = [
  { id: "mistakes", label: "A few mistakes" },
  { id: "warps", label: "Warps" },
  { id: "tpa", label: "Teleport requests" },
];
const snippets = [
  { id: "event", label: "Event" },
  { id: "command", label: "Command" },
  { id: "function", label: "Function" },
  { id: "every", label: "Periodic event" },
  { id: "options", label: "Options" },
];
const counts = [
  { id: "errors", label: "Errors" },
  { id: "warnings", label: "Warnings" },
  { id: "functions", label: "Functions" },
  { id: "variables", label: "Variables" },
  { id: "commands", label: "Commands" },
];
---
<Base
  title="Parser · NeoSkript"
  description="Paste a Skript script and see its errors and warnings, from NeoSkript's own parser running in your browser. Nothing is uploaded."
  path="/parser/"
  app
>
  <h1 class="sr-only">Parser</h1>
  <div class="tool">
    <div class="menubar">
      <div class="menus">
        <button type="button" class="icon-btn" id="save" aria-label="Save in this browser" title="Save in this browser (Ctrl+S)"><Icon name="save" /></button>
        <button type="button" class="icon-btn" id="open-settings" aria-label="Settings" title="Settings" aria-haspopup="dialog"><Icon name="gear" /></button>

        <div class="menu">
          <button type="button" class="menu-btn" id="file-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="file-menu">File</button>
          <ul class="menu-list" id="file-menu" role="menu" aria-labelledby="file-btn" hidden>
            <li role="none"><button type="button" role="menuitem" data-action="new">New file</button></li>
            <li role="none"><button type="button" role="menuitem" data-action="open">Open from your device…</button></li>
            <li role="none"><button type="button" role="menuitem" data-action="download">Download .sk</button></li>
            <li role="separator"></li>
            <li role="none"><button type="button" role="menuitem" data-action="rename">Rename…</button></li>
            <li role="none"><button type="button" role="menuitem" data-action="close">Close file</button></li>
          </ul>
        </div>
        <div class="menu">
          <button type="button" class="menu-btn" id="insert-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="insert-menu">Insert</button>
          <ul class="menu-list" id="insert-menu" role="menu" aria-labelledby="insert-btn" hidden>
            <li role="presentation" class="menu-head label" id="examples-head">Examples</li>
            {examples.map((e) => <li role="none"><button type="button" role="menuitem" data-example={e.id}>{e.label}</button></li>)}
            <li role="separator"></li>
            <li role="presentation" class="menu-head label">Snippets</li>
            {snippets.map((s) => <li role="none"><button type="button" role="menuitem" data-snippet={s.id}>{s.label}</button></li>)}
          </ul>
        </div>
        <div class="menu">
          <button type="button" class="menu-btn" id="share-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="share-menu">Sharing</button>
          <ul class="menu-list" id="share-menu" role="menu" aria-labelledby="share-btn" hidden>
            <li role="none"><button type="button" role="menuitem" data-action="share">Copy share link</button></li>
            <li role="none"><button type="button" role="menuitem" data-action="copy">Copy the script</button></li>
          </ul>
        </div>
        <div class="menu">
          <button type="button" class="menu-btn" id="help-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="help-menu">Help</button>
          <ul class="menu-list" id="help-menu" role="menu" aria-labelledby="help-btn" hidden>
            <li role="none"><a role="menuitem" href="/docs/parser/">Using the parser</a></li>
            <li role="none"><a role="menuitem" href="/docs/parser-checks/">What it checks</a></li>
            <li role="none"><a role="menuitem" href="/syntax/">Syntax reference</a></li>
            <li role="none"><button type="button" role="menuitem" data-action="keys">Keyboard shortcuts</button></li>
            <li role="separator"></li>
            <li role="none"><a role="menuitem" href={`${repo}/issues/new/choose`}>Report a bug<External /></a></li>
          </ul>
        </div>
      </div>

      <div class="files">
        <div class="tab">
          <button type="button" class="tab-name" id="tab-name" title="Rename">Untitled.sk</button>
          <input class="tab-input" id="tab-input" type="text" aria-label="File name" spellcheck="false" autocomplete="off" hidden />
          <button type="button" class="icon-btn small" id="tab-close" aria-label="Close file" title="Close file"><Icon name="close" /></button>
        </div>
        <button type="button" class="icon-btn" id="new-file" aria-label="New file" title="New file"><Icon name="plus" /></button>
        <div class="menu end">
          <button type="button" class="icon-btn" id="files-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="files-menu" aria-label="Open files" title="Open files"><Icon name="files" /><Icon name="chevron" class="chevron" /></button>
          <ul class="menu-list" id="files-menu" role="menu" aria-labelledby="files-btn" hidden></ul>
        </div>
        <button type="button" class="parse-btn" id="parse" title="Parse (Ctrl+Enter)"><Icon name="parse" /><span>Parse</span></button>
      </div>
    </div>

    <div class="split">
      <div class="editor-pane">
        <div class="editor" id="editor"><p class="editor-note" id="editor-note">Loading the editor…</p></div>
      </div>

      <section class="results" aria-labelledby="results-title">
        <div class="results-head">
          <h2 id="results-title">Problems</h2>
          <button type="button" class="text-btn" id="show-problems" hidden>Show problems</button>
        </div>
        <div class="waiting" id="waiting">
          <p class="waiting-title">Waiting on you</p>
          <button type="button" class="btn btn-primary" id="waiting-parse">Click to parse</button>
          <p class="about">
            NeoSkript's own parser, running in your browser: the script stays on your device. It checks against
            <span id="about">NeoSkript {neoskript} on {server}</span>, the same syntax as the
            <a href="/syntax/">reference</a>. <a href="/docs/parser-checks/">What it checks</a>
          </p>
        </div>
        <ol class="cards" id="cards" aria-labelledby="results-title" hidden></ol>
      </section>
    </div>

    <footer class="statusbar" aria-label="Parse status">
      <p class="stat"><span class="stat-key">Status:</span> <span class="stat-word" id="status-word">Loading</span></p>
      <ul class="counts">
        {counts.map((c) => (
          <li><button type="button" class="count" data-view={c.id} aria-pressed="false"><span class="n" id={`count-${c.id}`}>0</span> {c.label}</button></li>
        ))}
      </ul>
      <span class="timing" id="timing"></span>
      <button type="button" class="click-parse" id="status-parse">Click to parse</button>
    </footer>
  </div>

  <p class="sr-only" id="live" role="status"></p>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <input type="file" id="file-input" accept=".sk,.txt,text/plain" hidden />

  <dialog class="dialog" id="settings" aria-labelledby="settings-title">
    <form method="dialog">
      <h2 id="settings-title">Settings</h2>
      <label class="check"><input type="checkbox" id="set-live" /> Parse as you type</label>
      <label class="check"><input type="checkbox" id="set-minimap" /> Show the minimap</label>
      <label class="check"><input type="checkbox" id="set-wrap" /> Wrap long lines</label>
      <label class="check"><input type="checkbox" id="set-tab" /> <span>Tab moves focus instead of indenting <span class="hint">(also Ctrl+M, or Ctrl+Shift+M on a Mac)</span></span></label>
      <label class="field-row">Editor font size
        <select id="set-font">
          {[12, 13, 14, 15, 16, 18, 20].map((n) => <option value={n}>{n}px</option>)}
        </select>
      </label>
      <div class="dialog-actions"><button class="btn btn-primary" value="close">Done</button></div>
    </form>
  </dialog>

  <dialog class="dialog" id="keys" aria-labelledby="keys-title">
    <form method="dialog">
      <h2 id="keys-title">Keyboard shortcuts</h2>
      <dl class="keys">
        <div><dt><kbd>Ctrl</kbd>+<kbd>Enter</kbd></dt><dd>Parse the script</dd></div>
        <div><dt><kbd>Ctrl</kbd>+<kbd>S</kbd></dt><dd>Save in this browser</dd></div>
        <div><dt><kbd>F8</kbd></dt><dd>Next problem in the editor (<kbd>Shift</kbd>+<kbd>F8</kbd>, previous)</dd></div>
        <div><dt><kbd>Ctrl</kbd>+<kbd>G</kbd></dt><dd>Go to a line (<kbd>Ctrl</kbd>+<kbd>G</kbd> on a Mac too)</dd></div>
        <div><dt><kbd>Ctrl</kbd>+<kbd>F</kbd></dt><dd>Find, and <kbd>Ctrl</kbd>+<kbd>H</kbd> to replace (<kbd>Cmd</kbd>+<kbd>Option</kbd>+<kbd>F</kbd> on a Mac)</dd></div>
        <div><dt><kbd>Ctrl</kbd>+<kbd>/</kbd></dt><dd>Comment or uncomment the lines</dd></div>
        <div><dt><kbd>Ctrl</kbd>+<kbd>M</kbd></dt><dd>Make <kbd>Tab</kbd> move focus out of the editor, or indent again (<kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>M</kbd> on a Mac)</dd></div>
        <div><dt><kbd>F1</kbd></dt><dd>Every editor command</dd></div>
      </dl>
      <p class="hint">On a Mac, <kbd>Cmd</kbd> for <kbd>Ctrl</kbd> unless it says otherwise.</p>
      <div class="dialog-actions"><button class="btn btn-primary" value="close">Done</button></div>
    </form>
  </dialog>
</Base>

<script>
  import "../scripts/parser-page.ts";
</script>

<style>
  .tool {
    --bar: var(--night);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: calc(100dvh - 4.5rem - 1px);
    min-height: 28rem;
  }

  /* ---- Menu bar. */
  .menubar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.25rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    background: var(--bar);
  }
  .menus,
  .files {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    min-width: 0;
  }
  .icon-btn,
  .menu-btn,
  .tab-name,
  .parse-btn,
  .text-btn,
  .count,
  .click-parse {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
    transition: color 180ms var(--ease), background-color 180ms var(--ease);
  }
  .icon-btn {
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.5rem;
    border-radius: 4px;
  }
  .icon-btn.small {
    min-width: 1.75rem;
    height: 1.75rem;
    padding: 0;
  }
  .icon-btn .chevron {
    width: 0.75rem;
    height: 0.75rem;
  }
  .menu-btn {
    height: 2.5rem;
    padding: 0 0.7rem;
    border-radius: 4px;
    font-size: 0.875rem;
  }
  .icon-btn:hover,
  .menu-btn:hover,
  .menu-btn[aria-expanded="true"],
  .icon-btn[aria-expanded="true"] {
    color: var(--text);
    background: color-mix(in srgb, var(--magenta) 10%, transparent);
  }

  .menu {
    position: relative;
  }
  .menu-list {
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.25rem);
    left: 0;
    min-width: 14rem;
    max-width: min(22rem, calc(100vw - 1.5rem));
    max-height: 70dvh;
    overflow-y: auto;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    background: var(--night);
    border: 1px solid var(--rule);
    border-radius: 4px;
  }
  .menu.end .menu-list {
    left: auto;
    right: 0;
  }
  .menu-list[hidden] {
    display: none;
  }
  .menu-list :global([role="menuitem"]),
  .menu-list :global([role="menuitemradio"]) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 2.25rem;
    padding: 0.3rem 0.75rem;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.875rem;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .menu-list :global([role="menuitem"]:hover),
  .menu-list :global([role="menuitem"]:focus-visible),
  .menu-list :global([role="menuitemradio"]:hover),
  .menu-list :global([role="menuitemradio"]:focus-visible) {
    background: color-mix(in srgb, var(--magenta) 14%, transparent);
    outline-offset: -2px;
  }
  .menu-list :global([aria-checked="true"]) {
    color: var(--magenta);
    font-weight: 600;
  }
  .menu-list :global([aria-checked="true"])::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: currentColor;
  }
  .menu-list [role="separator"] {
    margin: 0.35rem 0.25rem;
    border-top: 1px solid var(--rule);
  }
  .menu-head {
    padding: 0.4rem 0.75rem 0.2rem;
    font-size: 0.6875rem;
  }

  /* The current file, as a tab. */
  .tab {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    min-width: 0;
    height: 2.25rem;
    margin-right: 0.25rem;
    padding: 0 0.25rem 0 0.75rem;
    background: var(--raised);
    border: 1px solid var(--rule);
    border-bottom-color: var(--magenta);
    border-radius: 4px 4px 0 0;
  }
  .tab-name {
    min-width: 0;
    max-width: 16rem;
    height: 100%;
    padding: 0;
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.8125rem;
  }
  .tab-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: block;
    line-height: 2.25rem;
  }
  .tab-input {
    width: 12rem;
    height: 1.75rem;
    padding: 0 0.4rem;
    border: 1px solid var(--magenta);
    border-radius: 4px;
    background: var(--night);
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.8125rem;
  }
  .parse-btn {
    height: 2.25rem;
    margin-left: 0.5rem;
    padding: 0 0.9rem;
    border-radius: 999px;
    background: var(--magenta);
    color: var(--night);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .parse-btn:hover {
    background: color-mix(in srgb, var(--magenta) 85%, white);
  }
  .parse-btn .icon {
    fill: currentColor;
  }

  /* ---- Editor and results, two thirds and one third. */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr);
    min-height: 0;
  }
  .editor-pane {
    position: relative;
    min-width: 0;
    min-height: 0;
    background: var(--raised);
  }
  .editor {
    position: absolute;
    inset: 0;
    /* Monaco's widget CSS (menus, find, hover, the command palette) sizes itself with VS Code's design tokens,
       which the standalone editor never defines: without them borders and paddings drop out. Ours: hairlines,
       the tools' 4px corners, VS Code's spacing steps, and no shadows (Monaco's defaults draw them). */
    --vscode-strokeThickness: 1px;
    --vscode-cornerRadius-small: 4px;
    --vscode-cornerRadius-medium: 4px;
    --vscode-cornerRadius-large: 4px;
    --vscode-cornerRadius-xLarge: 4px;
    --vscode-cornerRadius-circle: 999px;
    --vscode-spacing-sizeNone: 0;
    --vscode-spacing-size20: 2px;
    --vscode-spacing-size40: 4px;
    --vscode-spacing-size60: 6px;
    --vscode-spacing-size80: 8px;
    --vscode-spacing-size100: 10px;
    --vscode-spacing-size120: 12px;
    --vscode-spacing-size160: 16px;
    --vscode-spacing-size200: 20px;
    --vscode-spacing-size240: 24px;
    --vscode-spacing-size280: 28px;
    --vscode-spacing-size320: 32px;
    --vscode-spacing-size400: 40px;
    --vscode-fontSize-body1: 13px;
    --vscode-fontSize-body2: 12px;
    --vscode-fontSize-label2: 11px;
    --vscode-fontWeight-regular: 400;
    --vscode-fontWeight-semiBold: 600;
    --vscode-shadow-md: none;
    --vscode-shadow-lg: none;
    --vscode-shadow-xl: none;
  }
  .editor:focus-within {
    outline: 2px solid var(--magenta);
    outline-offset: -2px;
  }
  .editor-note {
    padding: 1rem 1.25rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .results {
    min-height: 0;
    overflow-y: auto;
    padding: 1rem;
    border-left: 1px solid var(--rule);
    background: var(--night);
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }
  .results-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .results h2 {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
  .text-btn {
    min-height: 2rem;
    padding: 0;
    color: var(--text);
    font-size: 0.875rem;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--text) 35%, transparent);
    text-underline-offset: 0.25em;
  }
  .text-btn:hover {
    text-decoration-color: var(--magenta);
  }
  .waiting {
    display: grid;
    justify-items: center;
    gap: 1rem;
    margin-top: 1rem;
    padding: clamp(2rem, 1rem + 4vh, 4rem) 1rem;
    text-align: center;
    border: 1px dashed var(--rule);
    border-radius: 4px;
  }
  .waiting[hidden] {
    display: none;
  }
  .waiting-title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .waiting .btn {
    border: 0;
    font-family: inherit;
    cursor: pointer;
  }
  .about {
    max-width: 34ch;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .about a {
    color: var(--text);
  }

  .cards {
    display: grid;
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .cards[hidden] {
    display: none;
  }
  .cards :global(.card) {
    border: 1px solid var(--rule);
    border-left: 3px solid var(--muted);
    border-radius: 4px;
    background: var(--raised);
  }
  .cards :global(.card.error) {
    border-left-color: var(--magenta);
  }
  .cards :global(.card.warning) {
    border-left: 3px dashed var(--string);
  }
  .cards :global(.card.ok) {
    border-left-color: var(--text);
  }
  .cards :global(.card-head) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.5rem 0.25rem 0;
  }
  .cards :global(.toggle) {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    min-height: 2.5rem;
    padding: 0 0.75rem;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.9375rem;
    text-align: left;
    cursor: pointer;
  }
  .cards :global(.toggle .icon) {
    margin-left: auto;
    color: var(--muted);
    transition: transform 180ms var(--ease);
  }
  .cards :global(.toggle[aria-expanded="false"] .icon) {
    transform: rotate(-90deg);
  }
  .cards :global(.sev) {
    font-weight: 700;
  }
  .cards :global(.error .sev) {
    color: var(--magenta);
  }
  .cards :global(.warning .sev) {
    color: var(--string);
  }
  .cards :global(.goto) {
    flex: none;
    min-height: 2rem;
    padding: 0 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: border-color 180ms var(--ease);
  }
  .cards :global(.goto:hover) {
    border-color: color-mix(in srgb, var(--magenta) 60%, var(--rule));
  }
  .cards :global(.card-body) {
    display: grid;
    gap: 0.6rem;
    padding: 0 0.75rem 0.75rem;
  }
  .cards :global(.card-body[hidden]) {
    display: none;
  }
  .cards :global(.message) {
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .cards :global(.code) {
    margin: 0;
    padding: 0.5rem 0.75rem;
    background: var(--night);
    border-radius: 4px;
    font-size: 0.8125rem;
    white-space: pre;
    overflow-x: auto;
    tab-size: 4;
  }
  .cards :global(.muted) {
    color: var(--muted);
    font-size: 0.875rem;
  }

  /* ---- Status bar. */
  .statusbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.25rem;
    min-height: 2.25rem;
    padding: 0 0.75rem;
    border-top: 1px solid var(--rule);
    background: var(--bar);
    font-family: var(--label);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .stat-key {
    color: var(--muted);
  }
  .stat-word {
    color: var(--text);
  }
  .stat-word.parsed {
    color: var(--magenta);
  }
  .counts {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .count,
  .click-parse {
    min-height: 2.25rem;
