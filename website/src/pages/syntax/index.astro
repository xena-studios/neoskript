---
// The syntax reference's front page: the sidebar, a search over everything with filters, and the categories.
import Base from "../../layouts/Base.astro";
import SyntaxNav from "../../components/syntax/SyntaxNav.astro";
import SearchBar from "../../components/syntax/SearchBar.astro";
import Icon from "../../components/Icon.astro";
import Attribution from "../../components/syntax/Attribution.astro";
import { categories, sinceOptions, syntax, total } from "../../lib/syntax";
import type { IconName } from "../../lib/icons";

const labels = JSON.stringify(Object.fromEntries(categories.map((c) => [c.path, c.label.toLowerCase()])));
const versions = sinceOptions([...syntax.elements, ...syntax.types, ...syntax.functions]);
---
<Base
  title="Syntax reference: NeoSkript"
  description={`All ${total} events, conditions, effects, expressions, types, sections, structures and functions NeoSkript registers, with patterns, descriptions and examples.`}
  path="/syntax/"
>
  <div class="ref">
    <SyntaxNav />
    <div class="main">
      <SearchBar versions={versions} count="" placeholder="Search all syntax: name, id or pattern" />
      <ol id="results" class="results" aria-label="Search results" data-labels={labels} hidden></ol>

      <header class="head">
        <h1>Syntax reference</h1>
        <p class="lead">
          Everything NeoSkript's core library registers, made from its own registry, so a pattern here is a pattern
          NeoSkript accepts.
        </p>
      </header>

      <ul class="cats">
        {categories.map((c) => (
          <li>
            <a href={`/syntax/${c.path}/`}>
              <span class="cat-head"><Icon name={c.kind as IconName} /><span class="cat-name">{c.label}</span><span class="n">{c.count}</span></span>
              <span class="blurb">{c.blurb}</span>
            </a>
          </li>
        ))}
      </ul>

      <Attribution />
    </div>
  </div>
</Base>

<script>
  import "../../scripts/syntax-search";
</script>

<style>
  .ref {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
  }
  .main {
    min-width: 0;
    max-width: 64rem;
    padding: 1.5rem clamp(1rem, 0.4rem + 3vw, 3rem) clamp(4rem, 2.5rem + 5vw, 7rem);
  }
  .head {
    padding-block: 1.5rem;
  }
  h1 {
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.5rem);
    letter-spacing: -0.035em;
  }
  .lead {
    margin-top: 1rem;
  }
  .results {
    display: grid;
    gap: 0.5rem;
    margin: 0.5rem 0 1rem;
    padding: 0;
    list-style: none;
  }
  .results[hidden] {
    display: none;
  }
  .results :global(a) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem 1rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--rule);
    border-left: 3px solid var(--magenta);
    border-radius: 4px;
    background: var(--raised);
    text-decoration: none;
    transition: background-color 180ms var(--ease);
  }
  .results :global(a:hover),
  .results :global(a:focus-visible) {
    background: color-mix(in srgb, var(--magenta) 10%, var(--raised));
  }
  .results :global(.r-name) {
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .results :global(.r-badges) {
    display: flex;
    gap: 0.35rem;
    align-self: center;
  }
  .results :global(.r-badges span) {
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: var(--night);
    color: var(--muted);
    font-family: var(--label);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .results :global(.r-pattern) {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: 0.8125rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 0.75rem;
    margin: 0 0 2.5rem;
    padding: 0;
    list-style: none;
  }
  .cats a {
    display: grid;
    gap: 0.5rem;
    height: 100%;
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--raised);
    text-decoration: none;
    transition: border-color 180ms var(--ease);
  }
  .cats a:hover {
    border-color: var(--magenta);
  }
  .cat-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .cat-head :global(.icon) {
    color: var(--magenta);
  }
  .cat-name {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .n {
    margin-left: auto;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .blurb {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  @media (max-width: 60rem) {
    .ref {
      grid-template-columns: minmax(0, 1fr);
    }
    .main {
      padding-top: 1rem;
    }
  }
</style>
