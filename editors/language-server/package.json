{
  "name": "@xena-studios/neoskript-language-server",
  "version": "0.1.0",
  "description": "The language server for Skript scripts (.sk), with NeoSkript's own parser: problems as you type, hover docs, completion, an outline and go to definition.",
  "license": "GPL-3.0-only",
  "author": "Xena Studios",
  "homepage": "https://neoskript.dev/docs/editors/",
  "repository": { "type": "git", "url": "https://github.com/xena-studios/neoskript", "directory": "editors/language-server" },
  "type": "module",
  "bin": { "neoskript-language-server": "dist/server.cjs" },
  "files": ["dist"],
  "scripts": {
    "docs": "node scripts/docs.mjs",
    "build": "node scripts/docs.mjs && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vscode-languageserver": "11.0.0",
    "vscode-languageserver-textdocument": "1.0.16"
  }
}
