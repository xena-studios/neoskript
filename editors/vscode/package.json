{
  "name": "neoskript",
  "displayName": "NeoSkript: Skript language support",
  "description": "Skript (.sk) for Skript and NeoSkript servers: problems as you type, hover docs, completion, an outline and go to definition, from NeoSkript's own parser.",
  "version": "0.1.0",
  "publisher": "xena-studios",
  "license": "GPL-3.0-only",
  "icon": "icon.png",
  "homepage": "https://neoskript.dev/docs/editors/",
  "repository": { "type": "git", "url": "https://github.com/xena-studios/neoskript", "directory": "editors/vscode" },
  "bugs": { "url": "https://github.com/xena-studios/neoskript/issues" },
  "categories": ["Programming Languages", "Linters", "Snippets"],
  "keywords": ["skript", "neoskript", "minecraft", "sk", "paper", "folia"],
  "engines": { "vscode": "^1.90.0" },
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "skript",
        "aliases": ["Skript", "skript"],
        "extensions": [".sk"],
        "configuration": "./language-configuration.json",
        "icon": { "light": "./icon.png", "dark": "./icon.png" }
      }
    ],
    "grammars": [
      { "language": "skript", "scopeName": "source.skript", "path": "./syntaxes/skript.tmLanguage.json" }
    ],
    "configurationDefaults": {
      "[skript]": {
        "editor.insertSpaces": false,
        "editor.detectIndentation": true,
        "editor.wordBasedSuggestions": "off"
      }
    },
    "commands": [
      { "command": "neoskript.restart", "title": "NeoSkript: Restart the language server" }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "package": "node scripts/build.mjs && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vscode-languageclient": "11.0.0"
  }
}
