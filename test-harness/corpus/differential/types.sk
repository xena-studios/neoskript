# Probe: values of different types as text, and conversions.

function probe_types():
	show("booleans", (true, false))
	show("items", (stone, 2 diamonds, a diamond sword, oak log))
	show("colors", (red, light blue, rgb(10, 20, 30)))
	show("vectors", (vector(1, 2, 3), vector(0.5, 0, -1)))
	set {_v} to vector(3, 4, 0)
	show("vector length", vector length of {_v})
	show("normalized", normalized {_v})
	show("location", location(1, 2, 3, world "world"))
	show("worlds", (world "world", all worlds))
	show("entity types", (zombie, a creeper, 3 pigs))
	show("potions", (speed, potion effect of speed of tier 2 for 10 seconds))
	show("enchantments", (sharpness 3, diamond sword of sharpness 2))
	show("parsed", ("stone" parsed as item type, "zombie" parsed as entity type))
	show("game modes", (survival, creative))
	show("console", console)
	show("unset", ({_unset}, whether {_unset} is set))
	show("uuid", uuid("00000000-0000-0000-0000-000000000001"))
	show("type check", whether 1 is a number)
	show("text check", whether "a" is a text)
	show("item amounts", (amount of 5 stone, 64 dirt))
	show("item name", name of (diamond named "Shiny"))
	show("chat colors", (red, dark gray, gold))
