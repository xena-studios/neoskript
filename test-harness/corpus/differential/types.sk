# Probe: values of different types as text, and conversions.

function probe_types():
	show("booleans", (true, false))
	show("items", (stone, 2 diamonds, a diamond sword, oak log))
	# Blocks with no item form (issue #60): their type is the block.
	show("type of a block with no item", (type of fire, type of water, type of nether portal))
	show("type of fire as text", "%type of fire%")
	show("type of fire is fire", whether type of fire is fire)
	show("colors", (red, light blue, rgb(10, 20, 30)))
	show("vectors", (vector(1, 2, 3), vector(0.5, 0, -1)))
	set {_v} to vector(3, 4, 0)
	show("vector length", vector length of {_v})
	show("normalized", normalized {_v})
	show("location", location(1, 2, 3, world "world"))
	show("worlds", (world "world", all worlds))
	show("entity types", (zombie, a creeper, 3 pigs))
	show("potions", (speed, potion effect of speed of tier 2 for 10 seconds))
	show("enchantments", (sharpness 3, diamond sword of sharpness 2))
	show("parsed", ("stone" parsed as item type, "zombie" parsed as entity type))
	# Only text is parsed, and an item stack has a parser (issue #77).
	set {_held} to diamond sword
	show("parsed item variable", ({_held} parsed as itemstack))
	show("parsed item stack", ("diamond sword" parsed as item stack))
	show("parsed several materials", ("any sword" parsed as itemstack))
	set {_number} to 5
	show("parsed number variable", ({_number} parsed as integer))
	# Converted to text first, as Skript's: a UUID is its text (review of #81).
	set {_u} to "00000000-0000-0000-0000-000000000001" parsed as uuid
	show("parsed uuid variable", ({_u} parsed as uuid))
	show("parsed block without item", ("fire" parsed as item stack))
	# Skript's own wording here: neither reads these as several materials.
	set {_ignored} to "any sword" parsed as itemstack
	show("several materials error", last parse error)
	set {_ignored} to "stone or dirt" parsed as itemstack
	show("stone or dirt error", last parse error)
	set {_ignored} to "fire" parsed as itemstack
	show("block without item error", last parse error)
	# A colon in a script's pattern is text to match: Skript escapes parse tags there (ExprParse.escapeParseTags).
	show("parsed tag before", "apples 5" parsed as "fruit:apples %number%")
	show("parsed tag text", "fruit:apples 5" parsed as "fruit:apples %number%")
	show("parsed tag spaced", "5" parsed as "x :%number%")
	show("parsed tag after", "all of 7" parsed as "[:all of] %number%")
	show("game modes", (survival, creative))
	show("console", console)
	show("unset", ({_unset}, whether {_unset} is set))
	show("uuid", uuid("00000000-0000-0000-0000-000000000001"))
	show("type check", whether 1 is a number)
	show("text check", whether "a" is a text)
	show("item amounts", (amount of 5 stone, 64 dirt))
	show("item name", name of (diamond named "Shiny"))
	show("chat colors", (red, dark gray, gold))
