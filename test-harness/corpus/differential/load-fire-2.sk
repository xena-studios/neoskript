# Probe: see load-fire-1. This script's 'on load' reaches load-fire-1's trigger and the one above it here, not the
# one below it, nor load-fire-3's.

on weather change:
	{diff::load-fire-on} is set
	add "2: weather, above the on load" to {diff::load-fire::*}

on load:
	add "2: load" to {diff::load-fire::*}
	set weather in world "world" to clear
	set {diff::load-fire-on} to true
	set weather in world "world" to rain
	delete {diff::load-fire-on}
	add "2: load, after the weather" to {diff::load-fire::*}

on weather change:
	{diff::load-fire-on} is set
	add "2: weather, below the on load" to {diff::load-fire::*}

function probe_load_fire_2():
	stop
