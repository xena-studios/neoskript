# Checks: words for values the event hasn't, in comparisons and loops, as Skript 2.17.0 gives their problems
# (issue #84).

function event_value_words():
	set {_x} to "a"
	# An entity's words on a comparison's side are the event value, which a function hasn't.
	if name of player is "x":
		send "1" to console
	# Words are one value.
	loop entity:
		send "2" to console
	# The world's properties with no world are their type's name.
	if {_x} is time:
		send "3" to console
	if {_x} is weather:
		send "4" to console
	# The chat message only works in a chat event.
	if {_x} is message:
		send "5" to console
	send "%whether {_x} is message%" to console
	set {_m} to message
	broadcast chat message
	if message is "a":
		send "6" to console
	# Only text on the other side can't be compared with the words the line starts with.
	if message is 1:
		send "6a" to console
	if message is {_x}:
		send "6b" to console
	if victim is 1:
		send "6c" to console
	# An item type is a container to a loop, so it can be looped.
	loop stone:
		send "6d" to console
	loop diamond sword:
		send "6e" to console
	loop armor stand:
		send "6f" to console
	loop fire:
		send "6g" to console

on load:
	if {_x} is time:
		send "7" to console
	if {_x} is message:
		send "8" to console
	loop the entity:
		send "9" to console

on chat:
	if {_x} is message:
		send "10" to console
