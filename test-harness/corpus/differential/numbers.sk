# Probe: how numbers are computed and printed.

function probe_numbers():
	show("ints", (1, 1.0, 1.5, -0.5 and 0))
	show("division", (1/3, 2/3, 10/4, 0.1 + 0.2, 0.1 * 3))
	show("big", (100000, 1000000, 1234567.891, 9007199254740993, 2147483647 + 1))
	show("small", (0.0001, 0.00001, 1.23456789, 1e3))
	show("powers", (2^10, 2^0.5, -2^2, (-2)^2))
	show("mod", (mod(10, 3), mod(-7, 3), 5 - 8))
	show("infinite", (1/0, -1/0, 0/0, sqrt(-1)))
	show("rounding", (floor(2.7), ceil(2.1), round(2.5), round(-2.5), round(3.14159, 2), abs(-3)))
	show("rounded", (1.5 rounded down, 1.5 rounded up, -1.5 rounded))
	show("min max", (min(3, 1, 2), max(3, 1, 2), sum(1, 2, 3), product(2, 3, 4)))
	show("logs", (ln(1), log(100), log(8, 2), exp(0)))
	show("trig", (sin(90), cos(180), tan(45), asin(1), atan2(1, 1)))
	set {_n} to 5
	add 2.5 to {_n}
	remove 1 from {_n}
	show("changed", ({_n}, {_n} * 2, {_n} / 0.5))
	show("compare", (whether 5 is between 1 and 10, whether 1 = 1.0, whether 0.1 + 0.2 = 0.3))
	show("parsed", "12" parsed as number)
	show("parsed integer", "1.5" parsed as integer)
	show("parsed bad", "abc" parsed as number)
	show("parsed comma", "1,000" parsed as number)
	set {_list::*} to 5, 3, 9 and 1
	show("sorted", sorted {_list::*})
	show("reversed", reversed {_list::*})
	show("stats", (size of {_list::*}, sum({_list::*}), mean(1, 2, 3, 4), median(1, 3, 2)))
	show("precedence", 1 + 2 * 3)
	show("parentheses", (1 + 2) * 3)
	show("power precedence", 2 * 3 ^ 2)
	show("left to right", 8 / 2 / 2)
	show("integers", all integers between 1 and 5)
	show("integers down", integers from 3 to 1)
	show("random range", whether (random integer between 1 and 3) is between 1 and 3)
