# Probe: list variables and loops.

function probe_lists():
	set {_l::*} to 3, 1 and 2
	show("list", ({_l::*}, {_l::1}, size of {_l::*}))
	show("indices", indices of {_l::*})
	add 4 to {_l::*}
	remove 1 from {_l::*}
	show("after add remove", {_l::*})
	show("indices", indices of {_l::*})
	set {_l::x} to "named"
	show("named", {_l::*})
	show("indices", indices of {_l::*})
	delete {_l::2}
	show("deleted", indices of {_l::*})
	loop {_l::*}:
		show("loop %loop-index%", loop-value)
	loop 3 times:
		show("times", loop-number)
	loop integers from 1 to 3:
		if loop-integer is 2:
			continue
		show("int", loop-integer)
	set {_m::a} to 1
	set {_m::b::c} to 2
	set {_m::b::d} to 3
	show("nested", ({_m::*}, {_m::b::*}))
	show("nested indices", indices of {_m::*})
	set {_s::*} to "b", "a" and "c"
	show("sorted", sorted {_s::*})
	show("first last", (first element of {_s::*}, last element of {_s::*}))
	show("filtered", {_s::*} where [input is not "a"])
	set {_n::*} to 5, 10 and 15
	add 1 to {_n::*}
	show("added to list", {_n::*})
	clear {_n::*}
	show("cleared", (size of {_n::*}, whether {_n::*} is set))
	set {_i} to 0
	while {_i} < 3:
		add 1 to {_i}
	show("while", {_i})
	set {_d::*} to 1, 1, 2 and 2
	show("duplicates", {_d::*})
	set {_e::*} to {_d::*}
	remove all 1 from {_e::*}
	show("remove all", {_e::*})
	set {_big::*} to integers between 1 and 12
	show("numeric order", indices of {_big::*})
	set {_k::10} to "ten"
	set {_k::9} to "nine"
	set {_k::a} to "a"
	set {_k::B} to "b"
	show("key order", indices of {_k::*})
	show("key values", {_k::*})
	set {_x::*} to "one" and "two"
	show("loop count", size of all integers between 1 and 100)
	# Deleting, then adding and reading what's left.
	set {_d::*} to "a", "b" and "c"
	delete {_d::3}
	add "d" to {_d::*}
	show("add after delete", indices of {_d::*})
	delete {_d::1}
	add "e" to {_d::*}
	show("add after first deleted", ({_d::*}, indices of {_d::*}))
	set {_e::x::y} to 1
	set {_e::z} to 2
	delete {_e::x::y}
	show("emptied list", (size of {_e::*}, indices of {_e::*}))
	set {_g::*} to "a", "b" and "c"
	loop {_g::*}:
		delete {_g::3}
		show("delete in loop", loop-value)
	show("after delete in loop", size of {_g::*})
	set {difftmp::x::y} to 1
	set {difftmp::x::z} to 2
	delete {difftmp::x::y}
	delete {difftmp::x::*}
	show("global emptied", (size of {difftmp::*}, {difftmp::x::z}))
	set {difftmp::kept} to "kept"
	# A list at a number, emptied one by one, keeps its index from add, as Skript keeps its map.
	set {_n::1::y} to 1
	set {_n::2} to "b"
	delete {_n::1::y}
	add "c" to {_n::*}
	show("add after emptied sublist", indices of {_n::*})
	set {_r::1::*} to "p" and "q"
	remove "p" and "q" from {_r::1::*}
	add "z" to {_r::*}
	show("add after sublist removed from", indices of {_r::*})
	delete {_r::1::*}
	add "y" to {_r::*}
	show("add after sublist deleted", indices of {_r::*})
