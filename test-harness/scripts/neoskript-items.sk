# The neoskript-items scenario: items and inventories, which need a server's registries. Each check that
# fails sends "[harness] items FAIL ..."; the harness waits for "[harness] items done".

function expect(label: text, actual: object, expected: object):
	if "%{_actual}%" is not "%{_expected}%":
		send "[harness] items FAIL %{_label}%: expected '%{_expected}%', got '%{_actual}%'" to console

on load:
	expect("plain", stone sword, "stone sword")
	expect("amount", 32 ender pearls, "32 ender pearls")
	expect("plural", 4 golden apples, "4 golden apples")
	expect("article", a diamond, "diamond")
	expect("singular of a plural name", stone brick, "stone bricks")
	expect("enchanted", diamond sword of sharpness 2, "diamond sword of sharpness 2")
	expect("roman level", iron pickaxe of efficiency iii, "iron pickaxe of efficiency 3")
	expect("named", stone named "Rock", "stone named ""Rock""")
	expect("amount of", item amount of 16 bread, 16)
	expect("parsed", "3 oak planks" parsed as item type, "3 oak planks")
	expect("not an item", "zzz" parsed as item type, "<none>")
	set {_items::*} to stone sword, 16 bread and leather chestplate
	expect("list", size of {_items::*}, 3)

	set {_menu} to chest inventory with 2 rows named "Menu"
	set slot 3 of {_menu} to ender pearl named "Go" with lore "Click"
	expect("slot", slot 3 of {_menu}, "ender pearl named ""Go""")
	expect("slot index", index of slot 3 of {_menu}, 3)
	expect("empty slot", slot 4 of {_menu}, "<none>")
	delete slot 3 of {_menu}
	expect("deleted slot", slot 3 of {_menu}, "<none>")
	send "[harness] items done" to console
