# The same script on Skript 2.17 with skript-yaml 1.7.2 and on NeoSkript with NeoSkriptYaml: the yaml-differential
# scenario compares each "[yaml] label: value" line and the files it leaves in plugins/YamlTest. The harness writes
# plugins/YamlTest/given.yml and plugins/YamlTest/folder/*.yml first, then runs each /yamltest-<part> command from the
# console, and /yamlping after each, so a part that fails on one of them doesn't stop the others.

function out(label: text, value: objects):
	send "[yaml] %{_label}%: %{_value::*}%" to console

command /yamlping <text>:
	trigger:
		send "[yaml] ping %arg-1%" to console

command /yamltest-values:
	trigger:
		# ---- a new file: texts, numbers, booleans, lists and nodes
		out("loaded before", whether yaml "values" is loaded)
		load yaml "plugins/YamlTest/values.yml"
		out("loaded after", whether yaml "values" is loaded)
		out("file exists", whether yaml file "plugins/YamlTest/values.yml" exists)
		out("empty at first", whether yaml "values" is empty)
		set yaml value "text.plain" of "values" to "hello world"
		set yaml value "text.number" of "values" to "5"
		set yaml value "text.decimal" of "values" to "2.5"
		set yaml value "text.yes" of "values" to "yes"
		set yaml value "text.kept" of "values" without string checks to "5"
		set yaml value "text.quote" of "values" to "it's ""quoted"": yes"
		set yaml value "numbers.whole" of "values" to 42
		set yaml value "numbers.decimal" of "values" to 1.25
		set yaml value "numbers.negative" of "values" to -7
		set yaml value "flag" of "values" to true
		set yaml list "list" of "values" to "a", "b" and 3
		add "c" to yaml list "list" of "values"
		remove "a" from yaml list "list" of "values"
		set index 1 of yaml list "list" of "values" to "B"
		out("empty after", whether yaml "values" is empty)
		out("modified", whether yaml "values" is modified)
		set {_v} to yaml value "text.plain" of "values"
		out("plain", {_v})
		set {_v} to yaml value "text.number" of "values"
		out("number from text", {_v} + 1)
		set {_v} to yaml value "text.yes" of "values"
		out("boolean from text", {_v})
		set {_v} to yaml value "numbers.decimal" of "values"
		out("decimal", {_v} * 2)
		out("list", yaml list "list" of "values")
		set {_v} to index 2 of yaml list "list" of "values"
		out("index 2", {_v})
		out("node keys", yaml node keys "text" of "values")
		out("root keys", yaml node keys "" of "values")
		out("nodes", yaml node list "numbers" of "values")
		out("has value", whether yaml path "flag" of "values" has value)
		out("no value", whether yaml path "nothing" of "values" has value)
		out("has list", whether yaml path "list" of "values" has list)
		out("no list", whether yaml path "flag" of "values" has list)
		out("exists", whether yaml path "text.plain" of "values" exists)
		out("doesn't exist", whether yaml path "text.nothing" of "values" exists)
		out("is list", whether yaml node "list" of "values" is a list)
		out("is node", whether yaml node "text" of "values" is a node)
		out("is value", whether yaml node "flag" of "values" is a value)
		out("isn't value", whether yaml node "text" of "values" is not a value)
		loop yaml node keys "text" of "values":
			out("loop key", loop-key)
			out("loop node", loop-node)
			out("loop val", loop-val)
			out("loop id", loop-id)
		loop yaml list "list" of "values":
			out("loop list val", loop-val)
		set the comments of yaml node "flag" of "values" to "The flag" and "two lines"
		set the header of "values" to "Values file" and "made by the test"
		out("comments", comments of yaml node "flag" of "values")
		out("header", header of "values")
		save yaml "values"
		out("modified after save", whether yaml "values" is modified)
		save yaml "values" to "plugins/YamlTest/values-compact.yml" with an indentation of 2 without extra lines between nodes

# Values of Skript's types: timespan, saved, then read back from the file.
command /yamltest-type-timespan:
	trigger:
		load yaml "plugins/YamlTest/types/timespan.yml" as "timespan"
		set yaml value "v" of "timespan" to 5 minutes
		save yaml "timespan"
		set {_v} to yaml value "v" of "timespan"
		out("type timespan set", {_v})
		unload yaml "timespan"
		load yaml "plugins/YamlTest/types/timespan.yml" as "timespan"
		set {_v} to yaml value "v" of "timespan"
		out("type timespan read", {_v})

