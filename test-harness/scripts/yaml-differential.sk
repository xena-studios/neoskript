command /yamltest-given:
	trigger:
		# ---- a file written by hand: header, comments, nested nodes, lists
		load yaml "plugins/YamlTest/given.yml"
		out("given header", header of "given")
		out("given comment", comments of yaml node "settings" of "given")
		out("given nodes", all yaml nodes of "given")
		out("given name", yaml value "settings.name" of "given")
		out("given ratio", yaml value "settings.ratio" of "given")
		out("given big", yaml value "settings.big" of "given")
		out("given id", yaml value "owner" of "given")
		out("given numbers", yaml list "numbers" of "given")
		loop yaml node keys "homes" of "given":
			out("home", loop-key)
			out("home node", loop-node)
			out("home keys", loop-subnodekeys)
		loop yaml node list "homes" of "given":
			out("home path", loop-value)
		remove "b" from yaml node keys "homes" of "given"
		delete yaml value "settings.ratio" of "given"
		out("ratio deleted", whether yaml path "settings.ratio" of "given" exists)
		save yaml "given" to "plugins/YamlTest/given-saved.yml"
		out("given still its own file", whether yaml file "plugins/YamlTest/given-saved.yml" exists)

# Text with colour codes: skript-yaml quotes it when it saves.
command /yamltest-colour:
	trigger:
		load yaml "plugins/YamlTest/colour-text.yml" as "colour text"
		set yaml value "text" of "colour text" to "&ahello"
		set {_v} to yaml value "text" of "colour text"
		out("colour", {_v})
		set {_v} to yaml value "text" of "colour text" without string checks
		out("colour unchecked", {_v})
		load yaml "plugins/YamlTest/motd.yml"
		out("motd", yaml value "motd" of "motd")
		save yaml "colour text"

# Several node keys at once.
command /yamltest-node-keys:
	trigger:
		load yaml "plugins/YamlTest/node-keys.yml" as "node keys"
		add "x" and "y" to yaml node keys "keys" of "node keys"
		out("node keys added", yaml node keys "keys" of "node keys")
		save yaml "node keys"

# A number read from a file and the same number from a script.
command /yamltest-numbers:
	trigger:
		load yaml "plugins/YamlTest/numbers.yml"
		remove 2 from yaml list "numbers" of "numbers"
		out("numbers after remove", yaml list "numbers" of "numbers")
		save yaml "numbers"

command /yamltest-folders:
	trigger:
		# ---- folders, ids, deleting
		load all yaml from directory "plugins/YamlTest/folder"
		out("folder loaded", sorted loaded yaml from directory "plugins/YamlTest/folder")
		unload yaml directory "plugins/YamlTest/folder"
		out("folder unloaded", whether yaml "plugins/YamlTest/folder/one.yml" is loaded)
		load all yaml from directory "plugins/YamlTest/folder" using the filename as the id
		out("folder by name", whether yamls "one" and "two" are loaded)
		out("unloaded in folder", sorted unloaded yaml files from directory "plugins/YamlTest/folder")
		change yaml id from "one" to "uno"
		out("renamed", whether yamls "uno" is loaded)
		out("old name", whether yaml "one" is loaded)
		set yaml value "renamed" of "uno" to true
		save yaml "uno"
		change yaml "two" file path to "plugins/YamlTest/moved/two.yml"
		save yaml "two"
		load yaml "plugins/YamlTest/doomed.yml"
		set yaml value "a" of "doomed" to 1
		save yaml "doomed"
		delete yaml "doomed" and keep loaded in memory
		out("doomed kept", whether yaml "doomed" is loaded)
		out("doomed file", whether yaml file "plugins/YamlTest/doomed.yml" exists)
		save yaml "doomed"
		save yaml "doomed" to "plugins/YamlTest/rescued.yml"
		delete yaml "uno"
		out("uno gone", whether yaml "uno" is loaded)
		out("loadYaml", loadYaml("fn", "plugins/YamlTest/fn.yml"))
		set yaml value "via function" of "fn" without string checks to "yes"
		save yaml "fn" without extra lines between nodes
		out("loaded", sorted loaded yaml)

# Deleting a folder's loaded files: skript-yaml's trigger waits for it.
command /yamltest-delete-folder:
	trigger:
		load all yaml from directory "plugins/YamlTest/doomed-folder"
		out("before", whether yaml "plugins/YamlTest/doomed-folder/a.yml" is loaded)
		delete all yaml from directory "plugins/YamlTest/doomed-folder"
		out("after", whether yaml "plugins/YamlTest/doomed-folder/a.yml" is loaded)
		out("file after", whether yaml file "plugins/YamlTest/doomed-folder/a.yml" exists)
		out("kept", whether yaml file "plugins/YamlTest/doomed-folder/notes.txt" exists)
